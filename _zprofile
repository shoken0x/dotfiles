eval "$(/opt/homebrew/bin/brew shellenv)"

# Java 12
# export JAVA_HOME="/Library/Java/JavaVirtualMachines/jdk-12.0.2.jdk/Contents/Home"
# Java 11
export JAVA_HOME="/usr/local/opt/openjdk@11"
# Java 8
# export JAVA_HOME="/Library/Internet Plug-Ins/JavaAppletPlugin.plugin/Contents/Home"

export PATH=${JAVA_HOME}/bin:${PATH}

export PATH="$HOME/node_modules/.bin:$PATH"
export PATH="$HOME/.nodenv/shims:$PATH"
# --no-rehash で起動を高速化（必要時に手動で `nodenv rehash`）
if which nodenv > /dev/null; then eval "$(nodenv init - --no-rehash zsh)"; fi

# for rbenv
# brew --prefix openssl@3 の結果（Apple Silicon 固定）をハードコードして高速化
export PATH="/opt/homebrew/opt/openssl@3/bin:$PATH"
export RUBY_CONFIGURE_OPTS="--with-openssl-dir=/opt/homebrew/opt/openssl@3 --disable-install-doc"
export PATH="$HOME/.rbenv/bin:$PATH"
# --no-rehash で起動を高速化（必要時に手動で `rbenv rehash`）
if which rbenv > /dev/null; then eval "$(rbenv init - --no-rehash zsh)"; fi

export HISTTIMEFORMAT='%Y%m%d %T';
export HISTCONTROL=ignoredups
export HISTFILE=${HOME}/.zsh_history

# for git diff-highlight
export PATH=$PATH:/opt/homebrew/share/git-core/contrib/diff-highlight
export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"

export MONGOPATH=/opt/mongodb
export PATH=$MONGOPATH/bin:$PATH

export GOOGLECLOUDSDKPATH=/opt/google-cloud-sdk
export PATH=$GOOGLECLOUDSDKPATH/bin:$PATH

export ANDROID_HOME=/Users/shoken/Library/Android/sdk
export PATH=$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools:$PATH
export REACT_EDITOR=vim
export PATH="$HOME/.local/bin:$PATH"

export DOCKER_HOST="unix:///Users/shoken/.colima/default/docker.sock"

# 単語の区切り文字をリセット（パスの / やドット . で削除が止まるようになる）
export WORDCHARS=''


# Load secret tokens from local unversioned file if it exists
if [ -f ~/.zshrc.local ]; then
  source ~/.zshrc.local
fi

# for aws-cli
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
# export EDITOR=vim
export AWS_CONFIG_FILE=~/.aws_access


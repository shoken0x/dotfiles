eval "$(/opt/homebrew/bin/brew shellenv)"

# Java 12
# export JAVA_HOME="/Library/Java/JavaVirtualMachines/jdk-12.0.2.jdk/Contents/Home"
# Java 11
export JAVA_HOME="/usr/local/opt/openjdk@11"
# Java 8
# export JAVA_HOME="/Library/Internet Plug-Ins/JavaAppletPlugin.plugin/Contents/Home"

export PATH=${JAVA_HOME}/bin:${PATH}

export PATH="$HOME/node_modules/.bin:$PATH"
export PATH="$HOME/.nodenv/shims:$PATH"
if which nodenv > /dev/null; then eval "$(nodenv init -)"; fi

# for rbenv
export PATH="$(brew --prefix openssl@3)/bin:$PATH"
export RUBY_CONFIGURE_OPTS="--with-openssl-dir=$(brew --prefix openssl@3) --disable-install-doc"
export PATH="$HOME/.rbenv/bin:$PATH"
if which rbenv > /dev/null; then eval "$(rbenv init -)"; fi

export HISTTIMEFORMAT='%Y%m%d %T';
export HISTCONTROL=ignoredups
export HISTFILE=${HOME}/.zsh_history

# for git diff-highlight
export PATH=$PATH:/opt/homebrew/share/git-core/contrib/diff-highlight
export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"

export MONGOPATH=/opt/mongodb
export PATH=$MONGOPATH/bin:$PATH

export GOOGLECLOUDSDKPATH=/opt/google-cloud-sdk
export PATH=$GOOGLECLOUDSDKPATH/bin:$PATH

export ANDROID_HOME=/Users/shoken/Library/Android/sdk
export PATH=$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools:$PATH
export REACT_EDITOR=vim
export PATH="$HOME/.cargo/bin:$PATH"

export PATH="$HOME/.local/bin:$PATH"

# Load secret tokens from local unversioned file if it exists
if [ -f ~/.zshrc.local ]; then
  source ~/.zshrc.local
fi

# for aws-cli
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export AWS_CONFIG_FILE=~/.aws_access

alias pong='perl -nle '\''print "display notification \"$_\" with title \"Terminal\""'\'' | osascript'
alias mdfind='mdfind -onlyin ./ -name'
#export LSCOLORS=gxfxcxdxbxegedabagacad
export LSCOLORS=HxFxCxdxBxegedabagacad
export LS_COLORS='di=97:ln=35:so=32:ex=31:bd=46;34:cd=43;34:su=41;30:sg=46;30:tw=42;30:ow=97'
alias ll='\ls -lahG'
alias ls='\ls -lahG'
alias be='bundle exec'
alias rai='bundle exec rails s'
alias rail='rai'
alias git='/opt/homebrew/bin/git'
alias gr='/opt/homebrew/bin/git grep'
alias python='/opt/homebrew/bin/python3.10'

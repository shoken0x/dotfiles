# claude plugin 一括更新: marketplace 情報を更新してから user スコープの全 plugin を更新する。
# list --json は同一 plugin を user/project 両スコープで重複して返すため select + sort -u で絞る。
# 更新の適用にはセッション再起動が必要。
claude-plugin-update-all() {
  claude plugin marketplace update && \
    claude plugin list --json \
      | jq -r '.[] | select(.scope=="user") | .id' \
      | sort -u \
      | xargs -n1 claude plugin update -y
}

alias brewup='brew update && brew upgrade && brew cleanup;ntn update;br upgrade;npm update -g;npx skills check;gh extension upgrade --all;claude-plugin-update-all'

# Figma MCP は使う時だけロードする（2026-08-26 の MCP 棚卸し）
# 常時接続だと system prompt の instructions が全 MCP 中で最大（~900 トークン）で、
# 実呼び出しは導入以来 2 回だけだったため、ユーザースコープから外して起動時オプトインにした。
# --mcp-config は既存の設定に「追加」する（--strict-mcp-config を付けない限り置換しない）ので、
# プロジェクトの .mcp.json（serena / context7）はそのまま効く。
alias claude-figma='claude --mcp-config ~/.claude/mcp/figma.json'

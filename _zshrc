# overwrite /etc/zshrc
export HISTSIZE=10000
export SAVEHIST=100000
export ZLS_COLORS=$LS_COLORS

# 履歴
setopt extended_history   # 履歴ファイルに時刻を記録
setopt inc_append_history # シェルの終了を待たずにコマンド履歴を保存
setopt share_history      # プロセスごとに履歴を共有
# setopt hist_expand        # !からの履歴補完. BANG_HIST の alias. default で on

# 履歴補完
# autoload -Uz predict-on && predict-on
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=5'
# syntax highlight
source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# コマンド補完
autoload -Uz compinit && compinit
autoload colors
zstyle ':completion:*' verbose yes
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' # 大文字、小文字を区別せず補完する
zstyle ':completion:*:default' menu select=1        # 補完候補のカーソル選択を有効
setopt list_packed                                  # 補完候補を詰めて表示

#setopt auto_cd           # ディレクトリ名で cd
#setopt autopushd         # cd 時に自動で push
#setopt pushd_ignore_dups # 同じディレクトリを pushd しない

setopt correct           # スペルチェック

# rm *で確認を求める機能を無効化する
setopt RM_STAR_SILENT
# コマンドライン実行時にもコメントを使えるようにする
setopt INTERACTIVE_COMMENTS

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/shoken/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/shoken/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/shoken/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/shoken/google-cloud-sdk/completion.zsh.inc'; fi
# Source local secrets and non-versioned config if it exists
if [ -f ~/.zshrc.local ]; then
source ~/.zshrc.local
fi

# History search
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

# Ctrl+P でさかのぼる (Previous)
bindkey "^P" up-line-or-beginning-search
# Ctrl+N で進む (Next)
bindkey "^N" down-line-or-beginning-search

# Starship
eval "$(starship init zsh)"

# Ghosttyターミナル開発レイアウト
# 使い方: tcode [ディレクトリ]
# 左上: yazi, 左下: keifu, 右: claude-code

tcode() {
  local target_dir="${1:-$(pwd)}"

  local cmd_yazi="cd ${target_dir} && yazi"
  local cmd_keifu="cd ${target_dir} && keifu"
  local cmd_claude="cd ${target_dir} && claude"
  local cmd_dir="cd ${target_dir}"

  # ヒアドキュメントを使用して AppleScript を実行
  # 変数展開を有効にするため EOF はクォートしない
  osascript <<EOF
    on run
        set cmd_yazi to "${cmd_yazi}"
        set cmd_keifu to "${cmd_keifu}"
        set cmd_claude to "${cmd_claude}"
        set cmd_dir to "${cmd_dir}"

        tell application "Ghostty" to activate
        tell application "System Events"
            tell process "Ghostty"
                -- 1. 縦分割 (Rightペイン作成)
                keystroke "d" using command down
                delay 0.25

                -- 2. 左ペインに戻る (ctrl+option+h)
                key code 4 using {control down, option down}
                delay 0.1

                -- 左上ペイン: yazi実行
                set the clipboard to cmd_yazi
                keystroke "v" using command down
                keystroke return
                delay 0.4

                -- 3. 横分割 (Bottom-Leftペイン作成)
                keystroke "d" using {command down, shift down}
                delay 0.25

                -- 左下ペイン: keifu実行
                set the clipboard to cmd_keifu
                keystroke "v" using command down
                keystroke return
                delay 0.15

                -- 4. 右ペインに移動 (ctrl+option+l)
                key code 37 using {control down, option down}
                delay 0.1

                -- 右上ペイン: claude実行
                set the clipboard to cmd_claude
                keystroke "v" using command down
                keystroke return
                delay 0.2

                -- 5. 右ペインをさらに横分割 (Bottom-Rightペイン作成)
                keystroke "d" using {command down, shift down}
                delay 0.25

                -- 右下ペイン: ディレクトリ移動実行
                set the clipboard to cmd_dir
                keystroke "v" using command down
                keystroke return
                delay 0.1

                -- 6. サイズ調整: 左側を狭くする
                repeat 6 times
                    key code 123 using {command down, control down}
                end repeat

                -- 左上ペインに移動して高さを調整
                key code 4 using {control down, option down}
                delay 0.1
                key code 40 using {control down, shift down}
                delay 0.1
                repeat 2 times
                    key code 125 using {command down, control down}
                end repeat

                -- 最後に右下のコンソールに戻る
                key code 37 using {control down, option down}
                delay 0.1
                key code 38 using {control down, shift down}
            end tell
        end tell
    end run
EOF
}

